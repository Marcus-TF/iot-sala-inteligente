  {
    "id": "regra",
    "type": "function",
    "z": "tab",
    "name": "Regra de automação",
    "func": "const d = msg.payload;\nif (!d || typeof d.temperatura !== 'number' || typeof d.umidade !== 'number') {\n    node.warn('leitura invalida descartada');\n    return null;\n}\nconst LIMITE_LIGAR = 28;\nconst LIMITE_DESLIGAR = 26;\nconst ts = d.ts > 1000000000 ? new Date(d.ts * 1000).toISOString() : new Date().toISOString();\nlet ligado = context.get('ligado') || false;\nconst total = (context.get('total') || 0) + 1;\ncontext.set('total', total);\nlet comando = null;\nif (!ligado && d.temperatura >= LIMITE_LIGAR) {\n    ligado = true;\n    comando = { acao: 'LIGAR', motivo: 'temperatura >= ' + LIMITE_LIGAR, ts: ts };\n} else if (ligado && d.temperatura <= LIMITE_DESLIGAR) {\n    ligado = false;\n    comando = { acao: 'DESLIGAR', motivo: 'temperatura <= ' + LIMITE_DESLIGAR, ts: ts };\n}\ncontext.set('ligado', ligado);\nreturn [\n    { payload: d.temperatura, topic: 'Temperatura' },\n    { payload: d.umidade },\n    comando ? { payload: comando } : null,\n    { payload: ts + ',' + d.temperatura + ',' + d.umidade + ',' + (ligado ? 1 : 0) },\n    { payload: total }\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 120,
    "wires": [
      [
        "gt",
        "ch"
      ],
      [
        "gu"
      ],
      [
        "cmd"
      ],
